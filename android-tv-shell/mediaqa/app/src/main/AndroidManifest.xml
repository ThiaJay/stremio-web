<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <uses-feature android:name="android.software.leanback" android:required="true"/>
  <application android:label="Original media QA only" android:allowBackup="false"
      android:usesCleartextTraffic="false" android:banner="@drawable/qa_banner" android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".MediaQaActivity" android:exported="true"
        android:screenOrientation="landscape">
      <intent-filter><action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
